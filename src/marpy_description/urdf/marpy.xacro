<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="marpy">

  <xacro:include filename="$(find marpy_description)/urdf/materials.xacro" />
  <xacro:include filename="$(find marpy_description)/urdf/marpy_gazebo.xacro" />

  <!-- ==================== Properties ==================== -->
  <!-- Wheel geometry (from CLAUDE.md specs) -->
  <xacro:property name="wheel_radius"     value="0.033" />
  <xacro:property name="wheel_separation" value="0.116" />  <!-- 2 * 0.058 -->

  <!-- ==================== base_footprint ==================== -->
  <!-- Ground-plane frame - sits at the contact point of the wheels -->
  <link name="base_footprint" />

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint" />
    <child link="base_link" />
    <origin xyz="0 0 0.04825" rpy="0 0 0" />
  </joint>

  <!-- ==================== base_link ==================== -->
  <link name="base_link">
    <inertial>
      <origin xyz="-0.006324 -9.655e-06 0.029104" rpy="0 0 0" />
      <mass value="0.370" />
      <inertia
        ixx="0.000410"  ixy="-3.76e-08" ixz="-5.34e-07"
        iyy="0.000657"  iyz="-1.72e-08"
        izz="0.001058" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://marpy_description/meshes/base_link.STL" />
      </geometry>
      <material name="light_blue" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://marpy_description/meshes/base_link.STL" />
      </geometry>
    </collision>
  </link>

  <!-- ==================== imu_link ==================== -->
  <link name="imu_link">
    <inertial>
      <origin xyz="-0.002055 -8.047e-05 0.000508" rpy="0 0 0" />
      <mass value="0.000548" />
      <inertia
        ixx="1.944e-08"  ixy="-3.334e-11" ixz="8.066e-11"
        iyy="8.684e-09"  iyz="-4.442e-11"
        izz="2.648e-08" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://marpy_description/meshes/imu_link.STL" />
      </geometry>
      <material name="dark_grey" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://marpy_description/meshes/imu_link.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link" />
    <child link="imu_link" />
    <origin xyz="0.024 0 0.0705" rpy="0 0 0" />
  </joint>

  <!-- ==================== left_wheel ==================== -->
  <link name="left_wheel">
    <inertial>
      <origin xyz="0 0.000627 0" rpy="0 0 0" />
      <mass value="0.167" />
      <inertia
        ixx="6.73e-05"  ixy="0"         ixz="0"
        iyy="1.132e-04" iyz="0"
        izz="6.73e-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://marpy_description/meshes/left_wheel.STL" />
      </geometry>
      <material name="dark_grey" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
      <geometry>
        <cylinder radius="${wheel_radius}" length="0.025" />
      </geometry>
    </collision>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="left_wheel" />
    <origin xyz="0.05725 0.058 -0.01525" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit effort="10" velocity="10" />
    <dynamics damping="0.1" friction="0.1" />
  </joint>

  <!-- ==================== right_wheel ==================== -->
  <link name="right_wheel">
    <inertial>
      <origin xyz="0 -0.000627 0" rpy="0 0 0" />
      <mass value="0.167" />
      <inertia
        ixx="6.73e-05"  ixy="0"         ixz="0"
        iyy="1.132e-04" iyz="0"
        izz="6.73e-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://marpy_description/meshes/right_wheel.STL" />
      </geometry>
      <material name="dark_grey" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
      <geometry>
        <cylinder radius="${wheel_radius}" length="0.025" />
      </geometry>
    </collision>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="right_wheel" />
    <origin xyz="0.05725 -0.058 -0.01525" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit effort="10" velocity="10" />
    <dynamics damping="0.1" friction="0.1" />
  </joint>

  <!-- ==================== caster_wheel ==================== -->
  <link name="caster_wheel">
    <inertial>
      <origin xyz="-0.008514 -0.000584 -0.01544" rpy="0 0 0" />
      <mass value="0.007" />
      <inertia
        ixx="4.87e-07"  ixy="-2.84e-09" ixz="-2.58e-08"
        iyy="5.86e-07"  iyz="-7.11e-10"
        izz="6.29e-07" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://marpy_description/meshes/caster_wheel.STL" />
      </geometry>
      <material name="dark_grey" />
    </visual>
    <collision>
      <origin xyz="0 0 -0.01425" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.019" />
      </geometry>
    </collision>
  </link>

  <joint name="caster_wheel_joint" type="fixed">
    <parent link="base_link" />
    <child link="caster_wheel" />
    <origin xyz="-0.09775 0 -0.015" rpy="0 0 0" />
  </joint>

</robot>
